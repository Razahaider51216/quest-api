# Local development defaults bind the API to this computer only.
HOST=127.0.0.1
PORT=3211

# Optional overrides. If omitted, local secrets are generated in data/secrets.json.
# SETUP_TOKEN=replace-with-a-long-random-value
# SESSION_SECRET=replace-with-at-least-32-random-characters
# LICENSE_PEPPER=replace-with-at-least-32-random-characters

# Set to production only behind HTTPS.
NODE_ENV=development
